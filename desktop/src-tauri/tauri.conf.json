{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dusk",
  "version": "0.1.0",
  "identifier": "io.github.zxypablo11.dusk",
  "build": {
    "beforeDevCommand": "npm run build:www",
    "beforeBuildCommand": "npm run build:www",
    "frontendDist": "../../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dusk",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
